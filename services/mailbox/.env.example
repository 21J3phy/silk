# Public configuration, supplied only after the provider/resource are approved.
# Issuer root URLs require their canonical trailing slash, when applicable.
SILK_ISSUER_URL=
SILK_RESOURCE_URL=
SILK_JWKS_URL=
SILK_ALLOWED_CLIENT_IDS=
SILK_ALLOWED_ORIGINS=
# Secret: enter only through the approved secure hosting configuration flow.
# Never paste a real connection string or token in chat, source, or a URL.
SILK_POSTGRES_DSN=
# Public CA bundle path, or system where the approved libpq supports it.
SILK_POSTGRES_CA=system
# Admin/migration authority for `python -m silk_live.admin`. Never set this in
# the running service's environment; pass it only to one-off admin commands.
# SILK_ADMIN_POSTGRES_DSN=
